[Unit]
Description=Learn Ukrainian daily counts-only issue readiness report

[Service]
Type=oneshot
WorkingDirectory=@REPO_ROOT@
Environment="LEARN_UKRAINIAN_PRIMARY_REPO_ROOT=@REPO_ROOT@"
Environment="LU_PRODUCT_ROOT=@REPO_ROOT@"
Environment="LU_DRIVER_STATE_CLI=%h/.local/bin/lu-driver-state"
ExecStart="@PYTHON@" -I -m lu_machinery.orchestration.issue_quality_report --publish --sender devops
ExecStart="@PYTHON@" -I -m lu_machinery.ops.error_digest --publish --sender devops
TimeoutStartSec=1800
Nice=15
IOSchedulingClass=idle
